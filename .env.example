# Copy to .env and fill in with your own Supabase project's values.
# Never commit the real .env file (see .gitignore).

# Public — safe to expose to the client (web/mobile app bundle).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — used by Supabase edge functions (e.g. account deletion, Phase 12).
# Must never be bundled into the client app or committed to source control.
SUPABASE_SERVICE_ROLE_KEY=
